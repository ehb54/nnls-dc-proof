# python
venv/
__pycache__/
*.pyc

# latex build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/main.pdf
paper/brookes_nnls_dc_optlett_draft*.pdf
paper/*-eps-converted-to.pdf

# working copies; the current PDFs are tracked under fixed names
paper/*_v[0-9]*.pdf
paper/submission_v*/

# cover letters and letterhead stay private (the letterhead carries a
# phone number); the leading * also catches the versioned deliverables
*cover_letter*
paper/UM_letterhead.pdf

# Lean build tree (Mathlib and its cache are several GB)
lean/.lake/
